# Autonomous AI QA Engineer — Environment Configuration
# Copy this file to .env and adjust variables as needed

# Mode: "demo" (no key needed), "gemini", "openai", or "anthropic"
LLM_PROVIDER=demo
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Persistence
DATABASE_URL=sqlite:///./apex_qa.db

# Frontend Origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Application Environment
APP_ENV=development
